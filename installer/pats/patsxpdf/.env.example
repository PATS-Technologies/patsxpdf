PATSXPDF_VERSION=1.1.1
POSTGRES_HOST=pats-postgres
POSTGRES_PORT=5432
POSTGRES_DB=pats
POSTGRES_SCHEMA=patsxpdf
POSTGRES_USER=pats
POSTGRES_PASSWORD='P@T$adm1n'
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD='P0stgres@dm1n'
SESSION_SECRET=gere-uma-chave-aleatoria-longa
APP_PORT=3002
# Serviço de comparação PATSCompare (container patscompare-app na rede pats-production)
PATSCOMPARE_URL=http://patscompare-app:3000
# URL pública do PATSCompare acessível pelo navegador (usada para embutir o resultado da comparação)
# Em teste local com ambos os serviços na mesma máquina, use http://localhost:3001
# Em produção, informe a URL pública real (ex.: https://compare.suaempresa.com)
PATSCOMPARE_PUBLIC_URL=http://localhost:3001
MAX_UPLOAD_MB=100
OFFICE_CONVERTER_TIMEOUT=120s
OFFICE_CONVERTER_TIMEOUT_MS=120000
FONTS_PATH=/usr/local/share/fonts/truetype/pats
OFFICE_FONT_CATALOG=/data/font-catalog/families.txt
ENGINE_API_TOKEN=gere-outro-token-aleatorio-longo
ENGINE_REQUEST_TIMEOUT_MS=300000
OCR_DPI=300
OCR_WORKERS=1
OCR_PAGE_TIMEOUT_SECONDS=180
