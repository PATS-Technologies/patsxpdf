#!/usr/bin/env bash
set -Eeuo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir"

if [[ -f VERSION ]]; then
  IFS= read -r version < VERSION
elif [[ -f package.json ]] && command -v jq >/dev/null 2>&1; then
  version="$(jq -er '.version | select(type == "string" and length > 0)' package.json)"
else
  echo "ERROR: Could not determine PATSXPDF version." >&2
  exit 1
fi
export PATSXPDF_VERSION="${PATSXPDF_VERSION:-$version}"

printf 'Stopping PATSXPDF services...\n'
docker compose down
printf 'PATSXPDF stopped.\n'
